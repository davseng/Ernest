# Server-only PostgreSQL connection string. Obtain this from Neon for deployed
# environments, or use a local PostgreSQL database. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@localhost:5432/ernest

# Generate with `npx auth secret`. Keep this server-only.
AUTH_SECRET=replace-with-a-random-secret

# Brevo SMTP relay. Port 587 uses STARTTLS; use the SMTP credentials supplied
# by Brevo, not a Brevo account password.
EMAIL_SERVER_HOST=smtp-relay.brevo.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=replace-with-brevo-smtp-login
EMAIL_SERVER_PASSWORD=replace-with-brevo-smtp-key
EMAIL_FROM="Ernest <sign-in@sailfarbetter.com>"

# The email address that should own the seeded Far Better asset.
SEED_OWNER_EMAIL=owner@example.com
